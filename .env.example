# Database (Track B)
DATABASE_URL=postgresql+psycopg://command_center:command_center@localhost:5432/command_center

# Ollama (Track A)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b

# LangSmith (Track A): tracing only turns on when LANGSMITH_API_KEY is set
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=command-center

# Agent actions: seconds before an action request gives up
AGENT_TIMEOUT_SECONDS=180
